{
  // Cloudflare Worker that resolves the discount offer server-side for the static
  // page (discount.html on resources.miacademy.co) and returns it.
  // Stores nothing, sends no email — it exists only to keep codes/pricing secret.
  //
  // Deploy: cd worker && wrangler deploy   (bundles offers.config.js)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discount-form-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-06-17",
  "observability": { "enabled": true },

  "vars": {
    "ALLOWED_ORIGIN": "https://resources.miacademy.co"
  }

  // Optional custom route (do NOT use resources.miacademy.co — that's the Pages site):
  // "routes": [{ "pattern": "api.miacademy.co/submit", "custom_domain": true }]
}
