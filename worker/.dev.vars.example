# Copy to `.dev.vars` (gitignored) for local `wrangler dev`. Documents secret NAMES only —
# never commit real secrets. Set production secrets with `wrangler secret put <NAME>`.

AIRTABLE_TOKEN=your-airtable-personal-access-token

# All discount codes + pricing live here as a single JSON string (one line for .dev.vars).
# In production this is set with: wrangler secret put DISCOUNT_CONFIG < offers.config.json
# For local dev, paste the minified JSON on one line:
DISCOUNT_CONFIG={"codes":{...},"warnings":[...],"validity":"...","income":{...},"offers":{...}}

# TURNSTILE_SECRET=your-turnstile-secret   # only if TURNSTILE_ENABLED=true
